# SL Studio environment variables (template)
#
# Copy this file to `.env` (which is gitignored) and fill in values as needed.
# All variables are optional; defaults work for typical local development.

# Tauri dev server host - set when developing against a remote device
# (e.g. mobile preview). Leave unset for normal localhost development.
# TAURI_DEV_HOST=

# CI flag - set automatically by GitHub Actions / other CI runners.
# Affects Playwright behavior (forbidOnly, retries, workers, reuseExistingServer).
# CI=1
